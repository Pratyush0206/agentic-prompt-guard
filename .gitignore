*.sublime-project
*.sublime-workspace

# ── Logs & temp files ─────────────────────────────────────────────────────────
*.log
*.tmp
*.bak
*.swp
*.swo

# ── Large datasets (too large for normal git commits) ──────────────────────────
# Regenerate with: python generate_dataset.py
generated_pharma_dataset_*.csv

# Training dataset (50 MB) — store locally, do not commit
train_dataset.csv

# Train/val/test splits produced by scripts/analyze_dataset.py
data/train_split.csv
data/val_split.csv
data/test_split.csv
data/unique_prompts.csv

# Evaluation reports produced by scripts/analyze_dataset.py
evaluation_report*.txt
evaluation_report*.json
metrics_*.csv

# Scratch/partial result files
results/*.tmp

# Personal phase notes — not for commit, owner's eyes only
docs/
