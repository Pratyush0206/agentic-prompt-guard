# Agentic Prompt Guard — Environment Variables
#
# Copy this file to .env and fill in the values.
# The application reads these at startup via os.environ (no python-dotenv
# required — set them in your shell, Docker environment, or CI secrets).

# ---------------------------------------------------------------------------
# Redis cache (optional)
# ---------------------------------------------------------------------------
# Set REDIS_URL to enable the Redis classification cache.
# If unset, the cache is silently disabled and the guard falls back to the
# in-memory LRU cache + Ollama / heuristics as normal.
#
# Format: redis://[user:password@]host[:port][/db]
# Examples:
#   redis://localhost:6379/0            (local dev)
#   redis://:mypassword@redis:6379/0   (Docker Compose)
#   rediss://user:pass@my-redis.cloud:6380/0  (TLS / cloud)

REDIS_URL=redis://localhost:6379/0

# Cache TTL (time-to-live) in seconds.
# Default: 86400 (24 hours).  Set to 172800 for 48 hours.
# Must be a positive integer.

CACHE_TTL=86400

# ---------------------------------------------------------------------------
# Ollama (optional — only needed for the LLM backend)
# ---------------------------------------------------------------------------
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.2:latest
